# Copy to .env.local to change the defaults.
#
# NEXT_PUBLIC_* values are inlined into the client JavaScript at build time
# (`next build`; `next dev` reads them at startup). After changing one, restart
# `next dev` or rebuild. Invalid values fall back to the defaults with a
# console warning; an invalid transport never selects the backend.

# mock (default): offline demo with synthetic sample data.
# backend: the FastAPI simulation backend (HTTP + SSE).
NEXT_PUBLIC_SIMULATION_TRANSPORT=mock

# Backend origin, no trailing slash needed. The dashboard's own origin must be
# in the backend's GREENWAVE_CORS_ORIGINS (default http://localhost:3000) and
# match exactly: http://127.0.0.1:3000 and http://localhost:3000 are different
# origins, and a CORS rejection shows up as "Simulation backend unreachable".
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public CARTO browser key for styles, tiles, glyphs, and sprites.
# Restrict to your website in CARTO's dashboard; rebuild after changing.
NEXT_PUBLIC_CARTO_API_KEY=

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/graphify-refresh.sh\"",
            "timeout": 60,
            "statusMessage": "Refreshing code graph"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/graphify-refresh.sh\" --json",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

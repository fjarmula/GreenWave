# Copy to deploy/.env. Never commit deploy/.env.
# Hostname only: no https:// prefix, path, or trailing slash.
DOMAIN=your-greenwave-name.duckdns.org
ACME_EMAIL=you@example.com
DEMO_USERNAME=demo
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Paste the hash BETWEEN SINGLE QUOTES to preserve its dollar signs.
DEMO_PASSWORD_HASH=''
# Public browser key: restrict it to DOMAIN in the CARTO dashboard.
CARTO_API_KEY=
